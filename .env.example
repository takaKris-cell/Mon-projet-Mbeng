# ─────────────────────────────────────────────────────────────────────────────
# Mon Projet Mbeng — variables d'environnement (Manuel backend §8.3)
# Ce fichier est versionné SANS valeurs réelles. Les vraies valeurs vivent
# uniquement dans les variables d'environnement de la plateforme d'hébergement
# et ne sont JAMAIS commitées.
# ─────────────────────────────────────────────────────────────────────────────

# Outils de développement (bascule de portail, codes OTP affichés, simulateur
# de paiement). Mettre à "true" pour les désactiver même en développement.
# En production ils sont de toute façon éliminés du bundle à la compilation.
VITE_DISABLE_DEV_TOOLS=false

# ── À renseigner lors de la bascule vers Supabase ───────────────────────────
# Clés publiques (préfixe VITE_ : envoyées au navigateur).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Secrets serveur — JAMAIS de préfixe VITE_, jamais côté navigateur ───────
# La clé service_role contourne les RLS : elle ne vit que dans les Edge
# Functions et les route handlers (Manuel §1.3).
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business API (canal OTP principal)
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_BUSINESS_TOKEN=

# Fournisseur SMS de secours adapté au marché africain (jamais Twilio, §3.2)
SMS_FALLBACK_PROVIDER_URL=
SMS_FALLBACK_PROVIDER_KEY=

# Encaissements — identifiants de TEST en développement et préproduction
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Supervision
SENTRY_DSN=
